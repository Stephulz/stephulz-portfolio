    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@configcat/sdk": "^1.1.0",
    "@ng-icons/bootstrap-icons": "^36.1.0",
    "@ng-icons/boxicons": "^36.1.0",
